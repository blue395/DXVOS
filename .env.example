# Copy to .env and fill in. Never commit .env.

# Runtime connection. Local: your Postgres. Production (Supabase): the Transaction pooler string (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dxvos"

# Production only: direct connection for migrations — Supabase Session pooler string (port 5432).
# Leave unset locally; DATABASE_URL is used instead.
# DIRECT_URL=""

# Leave unset for now: Supabase's DB-settings certificate doesn't match the pooler (docs/DEPLOY.md §1.4).
# DATABASE_CA_CERT=""

# At least 32 random characters: `openssl rand -base64 32`
SESSION_SECRET=""

# AI deck reading (docs/DEPLOY.md §5). All optional locally:
# without Supabase, decks are stored in .data/decks/; DECK_AI_MOCK=true fakes the AI.
# ANTHROPIC_API_KEY=""
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_SECRET_KEY=""
# DECK_AI_MOCK="true"

# Email for "Forgot password?" / sign-in links (docs/DEPLOY.md §9). Optional locally: without
# these, development prints each email (with its link) to the dev server console.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="angels@diversityx.vc"
# SMTP_PASS=""
# MAIL_FROM="DXV <angels@diversityx.vc>"
# APP_URL="https://app.diversityxventures.com"

# Google / Microsoft sign-in (docs/DEPLOY.md §10). Optional; each provider switches on with both values.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# Local testing only (ignored in production): point both providers at a stand-in OIDC server.
# OAUTH_DEV_SERVER="http://localhost:4545"
