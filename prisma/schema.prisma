// DXV OS data model — Week 1 (Dealflow).
// See DXV_OS_Product_Spec_FINAL.md §5–7 for the domain rules behind these tables.
//
// Conventions:
//  - Append-only tables (StageChange, MemoVersion, PreSelectionVote, InvestmentVote)
//    are only ever INSERTed by the app. There is deliberately no update/delete code
//    path for them, so history can't be rewritten.
//  - Money is stored in whole pounds (Int) — angel tickets are whole-pound amounts.

generator client {
  provider = "prisma-client"
  // Load a record and its relations in one SQL query (LATERAL joins) instead of one
  // query per relation: far fewer round trips to Supabase. Preview feature; remove
  // this line to go back to the default strategy.
  previewFeatures = ["relationJoins"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Users & auth ────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  // ANGEL — added when angel self-service login lands (deferred, spec §9)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  stageChanges       StageChange[]
  memoVersions       MemoVersion[]
  preSelectionVotes  PreSelectionVote[]
  investmentVotes    InvestmentVote[]
  founderCommsSent   FounderComm[]
  venturesCreated    Venture[]
  deckAnalyses       DeckAnalysis[]
  eligibilityReviews EligibilityReview[]
  memoAnalyses       MemoAnalysis[]
  memoDraftsCreated  MemoDraft[]         @relation("MemoDraftCreatedBy")
  memoDraftsUpdated  MemoDraft[]         @relation("MemoDraftUpdatedBy")
  memoScoreChanges   MemoScoreChange[]
  documentsUploaded  Document[]          @relation("DocumentUploadedBy")
  documentsArchived  Document[]          @relation("DocumentArchivedBy")
  ddReportJobs       DDReportJob[]
}

// ── Pipeline ────────────────────────────────────────────────────────────────

// Ten linear stages + the cross-cutting terminal PASSED state.
// Stages revised 2026-09-28 (values renamed in place so existing data kept its
// meaning). Order here matches pipeline order; src/lib/pipeline.ts is the source of
// truth for ordering and labels in code.
enum Stage {
  SUBMITTED
  ELIGIBILITY_SCREEN
  ADD_TO_PIPELINE // RETIRED 2026-09-28: kept only so old stage history still reads correctly
  PARTNER_REVIEW
  PITCH_SELECTION
  PITCH_OUTCOME
  INVESTMENT_COMMITMENTS
  DUE_DILIGENCE
  CAPITAL_TRANSFER
  INVESTMENT_COMPLETE
  SEIS_CERTIFICATE
  PASSED
}

enum PassReason {
  INSUFFICIENT_INTEREST
  DD_FLAG
  VALUATION_GAP
  FOUNDER_WITHDREW
  INELIGIBLE
  OTHER // requires a note
}

model Venture {
  id                String  @id @default(cuid())
  name              String
  founderNames      String?
  founderEmail      String?
  website           String?
  sector            String?
  companyStage      String? // e.g. "Pre-seed", "Seed"
  raiseAmountGbp    Int?
  round             Int? // DXV round the deal belongs to (Round 1, Round 2, ...)
  investedAmountGbp Int? // what DXV actually invested, entered once the investment completes
  description       String?
  deckUrl           String? // Google Drive link — files stay in Drive (spec §2)
  driveFolderUrl    String?

  currentStage   Stage       @default(SUBMITTED)
  stageEnteredAt DateTime    @default(now()) // denormalised from StageChange for fast "days in stage"
  passReason     PassReason? // set while currentStage = PASSED
  passNote       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  stageChanges       StageChange[]
  memoVersions       MemoVersion[]
  ddItems            DDItem[]
  preSelectionVotes  PreSelectionVote[]
  investmentVotes    InvestmentVote[]
  founderComms       FounderComm[]
  deckAnalyses       DeckAnalysis[]
  eligibilityReviews EligibilityReview[]
  memoAnalyses       MemoAnalysis[]
  memoDrafts         MemoDraft[]
  documents          Document[]
  ddReportJobs       DDReportJob[]

  @@index([currentStage])
}

// Append-only stage-history log (spec §5). fromStage is null for the creation row.
// changedById is null for moves made by the system (e.g. a data migration).
model StageChange {
  id          String      @id @default(cuid())
  ventureId   String
  venture     Venture     @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  fromStage   Stage?
  toStage     Stage
  passReason  PassReason?
  note        String?
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: Restrict) // never erase who moved a deal
  changedAt   DateTime    @default(now())

  @@index([ventureId, changedAt])
  @@index([changedAt])
}

// ── Deal review ─────────────────────────────────────────────────────────────

enum MemoVersionKind {
  DRIVE_LINK // RETIRED 2026-09-28: a memo in Google Drive (no longer created or shown)
  REVIEWED_MEMO // a partner-reviewed memo finalised in DXV OS (content stored here)
  UPLOADED_FILE // a memo file uploaded to DXV OS (see documentId)
}

// Investment memo, versioned and append-only (one version per pitch round, per spec).
// Either a Drive link, or a reviewed memo finalised in DXV OS from an AI draft.
model MemoVersion {
  id               String          @id @default(cuid())
  ventureId        String
  venture          Venture         @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  version          Int
  kind             MemoVersionKind @default(DRIVE_LINK)
  docUrl           String? // DRIVE_LINK only
  content          Json? // REVIEWED_MEMO only: the finalised memo
  sourceAnalysisId String? // REVIEWED_MEMO: which AI draft it started from
  sourceAnalysis   MemoAnalysis?   @relation(fields: [sourceAnalysisId], references: [id], onDelete: SetNull)
  documentId       String?         @unique // UPLOADED_FILE: the memo document
  document         Document?       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  summary          String?
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())

  @@unique([ventureId, version])
}

// ── AI-assisted investment assessment (DXV Partner Review) ──────────────────

// One AI assessment run: "AI draft N". Immutable once complete, so what the AI
// actually said is always on record. `context` snapshots what it was given.
model MemoAnalysis {
  id           String             @id @default(cuid())
  ventureId    String
  venture      Venture            @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  number       Int // AI draft number, per venture
  status       DeckAnalysisStatus @default(PENDING)
  model        String?
  context      Json // venture details, eligibility screen and notes, deck location
  output       Json? // the structured memo
  error        String?
  inputTokens  Int?
  outputTokens Int?
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  drafts   MemoDraft[]
  versions MemoVersion[]

  @@unique([ventureId, number])
}

// "DXV Review Draft N": the partners' one working draft per issue, started from an
// AI draft (or, for N > 1, from the previous issue). Saving updates it; "Mark complete"
// turns it into "DXV Review Issue N" (a locked MemoVersion) and closes it (archivedAt).
// Restarting from a different AI draft also archives the current one.
model MemoDraft {
  id          String       @id @default(cuid())
  number      Int          @default(1) // becomes DXV Review Issue <number>
  ventureId   String
  venture     Venture      @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  analysisId  String
  analysis    MemoAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  content     Json
  createdById String
  createdBy   User         @relation("MemoDraftCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?        @relation("MemoDraftUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  scoreChanges MemoScoreChange[]

  @@index([ventureId, archivedAt])
}

// Append-only log of a partner overruling a score in a draft.
model MemoScoreChange {
  id            String    @id @default(cuid())
  draftId       String
  draft         MemoDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  criterion     String
  fromScore     Int
  toScore       Int
  justification String? // the justification as saved with this change
  reason        String?
  changedById   String
  changedBy     User      @relation(fields: [changedById], references: [id])
  changedAt     DateTime  @default(now())

  @@index([draftId, changedAt])
}

// Due-diligence checklist item. This is working state (ticked/unticked), not history,
// so it is editable.
model DDItem {
  id          String     @id @default(cuid())
  ventureId   String
  venture     Venture    @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  title       String
  owner       String? // free text until Angels module links DD group members
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  documents   Document[]

  @@index([ventureId])
}

// ── Votes (spec §7) — two distinct entities, never collapsed ────────────────

// Pitch-selection stage: interest only, no ticket size. Append-only.
model PreSelectionVote {
  id           String   @id @default(cuid())
  ventureId    String
  venture      Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  angelName    String // free text in Week 1
  angelId      String? // reserved: linked to Angel record in Week 2
  interested   Boolean
  note         String?
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ventureId, createdAt])
}

// Investment-votes stage (EOI): interest + max ticket. Append-only; the latest
// record per angel is the one that counts towards the momentum threshold.
model InvestmentVote {
  id           String   @id @default(cuid())
  ventureId    String
  venture      Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  angelName    String
  angelId      String?
  interested   Boolean
  maxTicketGbp Int      @default(0)
  note         String?
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ventureId, createdAt])
}

// ── Decision gates & founder comms (spec §6) ────────────────────────────────

enum Gate {
  ELIGIBILITY
  PARTNER_REVIEW
  PITCH_SELECTION
  PITCH_OUTCOME
  INVESTMENT_COMMITMENTS
  DUE_DILIGENCE
  PASSED
}

enum CommsStatus {
  NOT_YET_SENT
  SENT
  FOUNDER_ACKNOWLEDGED
}

// Founder-facing comms owed at a decision gate. Created automatically (NOT_YET_SENT)
// when a venture crosses a gate; admins then mark it Sent / Acknowledged.
model FounderComm {
  id             String      @id @default(cuid())
  ventureId      String
  venture        Venture     @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  gate           Gate
  decision       String // e.g. "Proceed" / "Decline" — what the founder is being told
  status         CommsStatus @default(NOT_YET_SENT)
  sentAt         DateTime?
  sentById       String?
  sentBy         User?       @relation(fields: [sentById], references: [id])
  acknowledgedAt DateTime?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([ventureId, gate])
  @@index([status])
}

// ── AI deck reading & eligibility screen ────────────────────────────────────

enum DeckAnalysisStatus {
  PENDING // record created, deck uploading
  PROCESSING // background worker is reading it
  COMPLETE
  FAILED
}

// One AI pass over one uploaded deck: suggested Venture fields + the eligibility
// screen. Kept as its own record (never merged into the Venture), so a reviewer
// always sees the AI's first pass alongside their own judgement, not in place of it.
// ventureId is null while the deck belongs to a "New venture" form not yet saved.
model DeckAnalysis {
  id           String             @id @default(cuid())
  ventureId    String?
  venture      Venture?           @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  storagePath  String // private copy in Supabase Storage (bucket "decks")
  fileName     String
  fileSize     Int
  status       DeckAnalysisStatus @default(PENDING)
  model        String?
  extracted    Json? // suggested Venture fields
  screen       Json? // structured eligibility screen
  error        String?
  inputTokens  Int?
  outputTokens Int?
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  reviews EligibilityReview[]

  @@index([ventureId, createdAt])
}

enum EligibilityDecision {
  PROCEED
  DECLINE
  NEED_MORE_INFO
}

// The human decision on an eligibility screen. Append-only: a later decision is a
// new row. PROCEED and DECLINE also move the deal (via moveVentureStage).
model EligibilityReview {
  id          String              @id @default(cuid())
  ventureId   String
  venture     Venture             @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  analysisId  String?
  analysis    DeckAnalysis?       @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  decision    EligibilityDecision
  passReason  PassReason?
  note        String?
  decidedById String
  decidedBy   User                @relation(fields: [decidedById], references: [id])
  decidedAt   DateTime            @default(now())

  @@index([ventureId, decidedAt])
}

// ── Documents (DXV OS is the deal-lifecycle document store) ─────────────────

enum DocumentCategory {
  DECK
  MEMO
  DUE_DILIGENCE
  LEGAL
  FINANCIALS
  OTHER
}

// A file stored in DXV OS (Supabase Storage). Never deleted: DXV keeps all deal
// material, including declined deals, to learn from its dealflow. Mistaken uploads
// are archived (hidden), not deleted.
model Document {
  id           String           @id @default(cuid())
  ventureId    String
  venture      Venture          @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  category     DocumentCategory
  bucket       String // Supabase Storage bucket ("documents", or "decks" for AI-screened decks)
  storagePath  String
  fileName     String
  mimeType     String
  sizeBytes    Int
  ddItemId     String? // attached to a DD checklist item
  ddItem       DDItem?          @relation(fields: [ddItemId], references: [id], onDelete: SetNull)
  note         String?
  uploadedById String
  uploadedBy   User             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())
  uploadedAt   DateTime? // set once the browser confirms the upload finished (null = incomplete)
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?            @relation("DocumentArchivedBy", fields: [archivedById], references: [id])

  memoVersion MemoVersion?
  ddReportJob DDReportJob?

  @@unique([bucket, storagePath])
  @@index([ventureId, category])
}

// ── DD document generator ───────────────────────────────────────────────────

// One "Create DD document" run: AI drafts a DD plan, the worker builds a DXV-branded
// Word file and stores it as a Document (category Due diligence).
model DDReportJob {
  id           String             @id @default(cuid())
  ventureId    String
  venture      Venture            @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  status       DeckAnalysisStatus @default(PENDING)
  model        String?
  context      Json // deal details, memo, eligibility screen, DD items, deck location
  output       Json? // the AI's DD plan
  documentId   String?            @unique
  document     Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  error        String?
  inputTokens  Int?
  outputTokens Int?
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([ventureId, createdAt])
}
