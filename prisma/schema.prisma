// DXV OS data model — Week 1 (Dealflow).
// See DXV_OS_Product_Spec_FINAL.md §5–7 for the domain rules behind these tables.
//
// Conventions:
//  - Append-only tables (StageChange, MemoVersion, PreSelectionVote, InvestmentVote)
//    are only ever INSERTed by the app. There is deliberately no update/delete code
//    path for them, so history can't be rewritten.
//  - Money is stored in whole pounds (Int) — angel tickets are whole-pound amounts.

generator client {
  provider        = "prisma-client"
  // Load a record and its relations in one SQL query (LATERAL joins) instead of one
  // query per relation: far fewer round trips to Supabase. Preview feature; remove
  // this line to go back to the default strategy.
  previewFeatures = ["relationJoins"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Users & auth ────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ANGEL // a syndicate member's portal login (linked to one Angel record); sees only /portal
  SYSTEM // DXV OS itself (e.g. "DXV website" for founder submissions): never signs in
}

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  name                  String
  passwordHash          String
  role                  Role            @default(ADMIN)
  createdAt             DateTime        @default(now())
  angelId               String?         @unique // ANGEL users: their Angel record
  angel                 Angel?          @relation("AngelUser", fields: [angelId], references: [id])
  disabledAt            DateTime? // access revoked: treated as signed out everywhere
  lastSignInAt          DateTime?
  sessionVersion        Int             @default(0) // in every session; bumping it signs this login out everywhere
  loginLinks            LoginLink[]
  identities            LoginIdentity[]
  emailTemplatesCreated EmailTemplate[] @relation("EmailTemplateCreatedBy")
  emailTemplatesUpdated EmailTemplate[] @relation("EmailTemplateUpdatedBy")
  memberEmailsSent      MemberEmail[]
  founderEmailsSent     FounderEmail[]

  stageChanges            StageChange[]
  memoVersions            MemoVersion[]
  preSelectionVotes       PreSelectionVote[]
  investmentVotes         InvestmentVote[]
  founderCommsSent        FounderComm[]
  venturesCreated         Venture[]
  deckAnalyses            DeckAnalysis[]
  eligibilityReviews      EligibilityReview[]
  memoAnalyses            MemoAnalysis[]
  memoDraftsCreated       MemoDraft[]          @relation("MemoDraftCreatedBy")
  memoDraftsUpdated       MemoDraft[]          @relation("MemoDraftUpdatedBy")
  memoScoreChanges        MemoScoreChange[]
  documentsUploaded       Document[]           @relation("DocumentUploadedBy")
  documentsArchived       Document[]           @relation("DocumentArchivedBy")
  ddReportJobs            DDReportJob[]
  investmentVotesRemoved  InvestmentVote[]     @relation("InvestmentVoteRemovedBy")
  finalInvestmentsCreated FinalInvestment[]    @relation("FinalInvestmentCreatedBy")
  finalInvestmentsPaid    FinalInvestment[]    @relation("FinalInvestmentPaidBy")
  finalInvestmentsRemoved FinalInvestment[]    @relation("FinalInvestmentRemovedBy")
  entryAudits             EntryAudit[]
  playbookVersions        PlaybookVersion[]
  lessonsCreated          Lesson[]             @relation("LessonCreatedBy")
  lessonsApproved         Lesson[]             @relation("LessonApprovedBy")
  lessonsUpdated          Lesson[]             @relation("LessonUpdatedBy")
  lessonJobs              LessonJob[]
  brainConversations      BrainConversation[]
  angelsCreated           Angel[]              @relation("AngelCreatedBy")
  angelsUpdated           Angel[]              @relation("AngelUpdatedBy")
  angelCertifications     AngelCertification[]
  angelNotes              AngelNote[]
  angelAliases            AngelAlias[]
  angelInvitesCreated     AngelInvite[]
  dealShareLogs           DealShareLog[]
  teamInvitesCreated      TeamInvite[]         @relation("TeamInviteCreatedBy")
  teamInvites             TeamInvite[]         @relation("TeamInviteUser")
  teamEventsDone          TeamEvent[]          @relation("TeamEventActor")
  teamEvents              TeamEvent[]          @relation("TeamEventSubject")
  memberRounds            MemberRound[]
  syndicateHoldingsAdded  SyndicateHolding[]   @relation("SyndicateHoldingCreatedBy")
  syndicateHoldingsEdited SyndicateHolding[]   @relation("SyndicateHoldingUpdatedBy")
  complianceTextsCreated  ComplianceText[]     @relation("ComplianceTextCreatedBy")
  complianceTextsApproved ComplianceText[]     @relation("ComplianceTextApprovedBy")
}

// ── Pipeline ────────────────────────────────────────────────────────────────

// Ten linear stages + the cross-cutting terminal PASSED state.
// Stages revised 2026-09-28 (values renamed in place so existing data kept its
// meaning). Order here matches pipeline order; src/lib/pipeline.ts is the source of
// truth for ordering and labels in code.
enum Stage {
  SUBMITTED
  ELIGIBILITY_SCREEN
  ADD_TO_PIPELINE // RETIRED 2026-09-28: kept only so old stage history still reads correctly
  PARTNER_REVIEW
  PITCH_SELECTION
  PITCH_OUTCOME
  INVESTMENT_COMMITMENTS
  DUE_DILIGENCE
  CAPITAL_TRANSFER // RETIRED 2026-09-29: payments are tracked in Final Investment; kept for old stage history
  INVESTMENT_COMPLETE
  SEIS_CERTIFICATE
  PASSED
}

enum PassReason {
  INSUFFICIENT_INTEREST
  DD_FLAG
  VALUATION_GAP
  FOUNDER_WITHDREW
  INELIGIBLE
  OTHER // requires a note
}

model Venture {
  id                String  @id @default(cuid())
  name              String
  founderNames      String?
  founderEmail      String?
  website           String?
  sector            String?
  companyStage      String? // e.g. "Pre-seed", "Seed"
  raiseAmountGbp    Int?
  round             Int? // DXV round the deal belongs to (Round 1, Round 2, ...)
  investedAmountGbp Int? // LEGACY: typed-in invested amount; counts only if the deal has no Final Investment entries
  leadAngel         String? // DXV lead angel (Blué, Anna C, Kevin W, or another name)
  description       String?
  deckUrl           String? // Google Drive link — files stay in Drive (spec §2)
  driveFolderUrl    String?

  currentStage    Stage       @default(SUBMITTED)
  stageEnteredAt  DateTime    @default(now()) // denormalised from StageChange for fast "days in stage"
  passReason      PassReason? // set while currentStage = PASSED
  passNote        String?
  passedFromStage Stage? // where in the dealflow it was declined (set while currentStage = PASSED)

  // Deal room: angels see nothing unless DXV shares the deal (and then by stage).
  sharedWithAngelsAt DateTime? // null = not shared
  angelSummary       String? // what angels read about the company (written by DXV for members)

  importedAt DateTime? // added by the historical deals import (not entered live); dates are the original ones

  // The deal's one-line description: written or confirmed by the team, and the ONE line both
  // the team and members see (boards, deal pages, portfolios). Never filled by AI directly:
  // the AI screen's summary is only offered as a suggestion.
  oneLiner String?

  // Founder diversity themes (DXV's Playbook list; only what founders have stated). The single
  // source of truth: both portfolio views read it. Seeded from a memo's themes when one is
  // issued while this is empty; edited in the deal page's Details.
  founderDiversity String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  stageChanges       StageChange[]
  memoVersions       MemoVersion[]
  ddItems            DDItem[]
  preSelectionVotes  PreSelectionVote[]
  investmentVotes    InvestmentVote[]
  founderComms       FounderComm[]
  deckAnalyses       DeckAnalysis[]
  eligibilityReviews EligibilityReview[]
  memoAnalyses       MemoAnalysis[]
  memoDrafts         MemoDraft[]
  documents          Document[]
  ddReportJobs       DDReportJob[]
  finalInvestments   FinalInvestment[]
  entryAudits        EntryAudit[]
  lessons            Lesson[]
  lessonJobs         LessonJob[]
  shareLog           DealShareLog[]
  syndicateHolding   SyndicateHolding?
  founderSubmissions FounderSubmission[] @relation("SubmissionVenture")
  founderEmails      FounderEmail[]

  @@index([currentStage])
}

// Append-only stage-history log (spec §5). fromStage is null for the creation row.
// changedById is null for moves made by the system (e.g. a data migration).
model StageChange {
  id          String      @id @default(cuid())
  ventureId   String
  venture     Venture     @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  fromStage   Stage?
  toStage     Stage
  passReason  PassReason?
  note        String?
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: Restrict) // never erase who moved a deal
  changedAt   DateTime    @default(now())

  @@index([ventureId, changedAt])
  @@index([changedAt])
}

// ── Deal review ─────────────────────────────────────────────────────────────

enum MemoVersionKind {
  DRIVE_LINK // RETIRED 2026-09-28: a memo in Google Drive (no longer created or shown)
  REVIEWED_MEMO // a partner-reviewed memo finalised in DXV OS (content stored here)
  UPLOADED_FILE // a memo file uploaded to DXV OS (see documentId)
}

// Investment memo, versioned and append-only (one version per pitch round, per spec).
// Either a Drive link, or a reviewed memo finalised in DXV OS from an AI draft.
model MemoVersion {
  id               String          @id @default(cuid())
  ventureId        String
  venture          Venture         @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  version          Int
  kind             MemoVersionKind @default(DRIVE_LINK)
  docUrl           String? // DRIVE_LINK only
  content          Json? // REVIEWED_MEMO only: the finalised memo
  sourceAnalysisId String? // REVIEWED_MEMO: which AI draft it started from
  sourceAnalysis   MemoAnalysis?   @relation(fields: [sourceAnalysisId], references: [id], onDelete: SetNull)
  documentId       String?         @unique // UPLOADED_FILE: the memo document
  document         Document?       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  summary          String?
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())

  @@unique([ventureId, version])
}

// ── AI-assisted investment assessment (DXV Partner Review) ──────────────────

// One AI assessment run: "AI draft N". Immutable once complete, so what the AI
// actually said is always on record. `context` snapshots what it was given.
model MemoAnalysis {
  id           String             @id @default(cuid())
  ventureId    String
  venture      Venture            @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  number       Int // AI draft number, per venture
  status       DeckAnalysisStatus @default(PENDING)
  model        String?
  context      Json // venture details, eligibility screen and notes, deck location
  output       Json? // the structured memo
  error        String?
  inputTokens  Int?
  outputTokens Int?
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  drafts   MemoDraft[]
  versions MemoVersion[]

  @@unique([ventureId, number])
}

// "DXV Review Draft N": the partners' one working draft per issue, started from an
// AI draft (or, for N > 1, from the previous issue). Saving updates it; "Mark complete"
// turns it into "DXV Review Issue N" (a locked MemoVersion) and closes it (archivedAt).
// Restarting from a different AI draft also archives the current one.
model MemoDraft {
  id          String       @id @default(cuid())
  number      Int          @default(1) // becomes DXV Review Issue <number>
  ventureId   String
  venture     Venture      @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  analysisId  String
  analysis    MemoAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  content     Json
  createdById String
  createdBy   User         @relation("MemoDraftCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?        @relation("MemoDraftUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  scoreChanges MemoScoreChange[]

  @@index([ventureId, archivedAt])
}

// Append-only log of a partner overruling a score in a draft.
model MemoScoreChange {
  id            String    @id @default(cuid())
  draftId       String
  draft         MemoDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  criterion     String
  fromScore     Int
  toScore       Int
  justification String? // the justification as saved with this change
  reason        String?
  changedById   String
  changedBy     User      @relation(fields: [changedById], references: [id])
  changedAt     DateTime  @default(now())

  @@index([draftId, changedAt])
}

// Due-diligence checklist item. This is working state (ticked/unticked), not history,
// so it is editable.
model DDItem {
  id          String     @id @default(cuid())
  ventureId   String
  venture     Venture    @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  title       String
  owner       String? // free text until Angels module links DD group members
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  documents   Document[]

  @@index([ventureId])
}

// ── Votes (spec §7) — two distinct entities, never collapsed ────────────────

// Pitch-selection stage: interest only, no ticket size. Append-only.
model PreSelectionVote {
  id           String   @id @default(cuid())
  ventureId    String
  venture      Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  angelName    String // as typed (kept as recorded)
  angelId      String? // set when picked from the angel list; older entries link through AngelAlias
  angel        Angel?   @relation(fields: [angelId], references: [id], onDelete: SetNull)
  interested   Boolean
  note         String?
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ventureId, createdAt])
}

// Investment-votes stage (EOI): interest + max ticket. Append-only; the latest
// record per angel is the one that counts towards the momentum threshold.
model InvestmentVote {
  id           String    @id @default(cuid())
  ventureId    String
  venture      Venture   @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  angelName    String
  angelId      String? // set when picked from the angel list; older entries link through AngelAlias
  angel        Angel?    @relation(fields: [angelId], references: [id], onDelete: SetNull)
  interested   Boolean
  maxTicketGbp Int       @default(0)
  note         String?
  recordedById String
  recordedBy   User      @relation(fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())
  // Editable and removable since 2026-09-29 (Blue's decision); every change is logged in
  // EntryAudit, and removed entries are hidden, not deleted.
  editedAt     DateTime?
  removedAt    DateTime?
  removedById  String?
  removedBy    User?     @relation("InvestmentVoteRemovedBy", fields: [removedById], references: [id])

  @@index([ventureId, createdAt])
}

// Final investment: each angel's actual ticket, and whether the money has arrived.
// Paid tickets on deals at Investment Complete (or S/EIS) make the dashboard's Investment Total.
// Edits, payment ticks and removals are logged in EntryAudit; removed rows are hidden, not deleted.
model FinalInvestment {
  id          String    @id @default(cuid())
  ventureId   String
  venture     Venture   @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  angelName   String
  angelId     String? // set when picked from the angel list; older entries link through AngelAlias
  angel       Angel?    @relation(fields: [angelId], references: [id], onDelete: SetNull)
  ticketGbp   Int
  note        String?
  paidAt      DateTime?
  paidById    String?
  paidBy      User?     @relation("FinalInvestmentPaidBy", fields: [paidById], references: [id])
  createdById String
  createdBy   User      @relation("FinalInvestmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  removedAt   DateTime?
  removedById String?
  removedBy   User?     @relation("FinalInvestmentRemovedBy", fields: [removedById], references: [id])

  holding PortfolioHolding? // the angel's own details for this investment (My Portfolio)

  @@index([ventureId, createdAt])
}

enum AuditEntity {
  INVESTMENT_VOTE
  FINAL_INVESTMENT
}

enum AuditAction {
  EDIT
  REMOVE
  PAID
  UNPAID
}

// Append-only log of edits and removals on EOIs and final investments: the values
// before (and after) each change, and who made it.
model EntryAudit {
  id          String      @id @default(cuid())
  ventureId   String
  venture     Venture     @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  entity      AuditEntity
  entryId     String
  action      AuditAction
  before      Json
  after       Json?
  changedById String
  changedBy   User        @relation(fields: [changedById], references: [id])
  changedAt   DateTime    @default(now())

  @@index([ventureId, changedAt])
}

// ── Decision gates & founder comms (spec §6) ────────────────────────────────

enum Gate {
  ELIGIBILITY
  PARTNER_REVIEW
  PITCH_SELECTION
  PITCH_OUTCOME
  INVESTMENT_COMMITMENTS
  DUE_DILIGENCE
  PASSED
}

enum CommsStatus {
  NOT_YET_SENT
  SENT
  FOUNDER_ACKNOWLEDGED
}

// Founder-facing comms owed at a decision gate. Created automatically (NOT_YET_SENT)
// when a venture crosses a gate; admins then mark it Sent / Acknowledged.
model FounderComm {
  id             String      @id @default(cuid())
  ventureId      String
  venture        Venture     @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  gate           Gate
  decision       String // e.g. "Proceed" / "Decline" — what the founder is being told
  status         CommsStatus @default(NOT_YET_SENT)
  sentAt         DateTime?
  sentById       String?
  sentBy         User?       @relation(fields: [sentById], references: [id])
  acknowledgedAt DateTime?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([ventureId, gate])
  @@index([status])
}

// ── AI deck reading & eligibility screen ────────────────────────────────────

enum DeckAnalysisStatus {
  PENDING // record created, deck uploading
  PROCESSING // background worker is reading it
  COMPLETE
  FAILED
}

// One AI pass over one uploaded deck: suggested Venture fields + the eligibility
// screen. Kept as its own record (never merged into the Venture), so a reviewer
// always sees the AI's first pass alongside their own judgement, not in place of it.
// ventureId is null while the deck belongs to a "New venture" form not yet saved.
model DeckAnalysis {
  id           String             @id @default(cuid())
  ventureId    String?
  venture      Venture?           @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  storagePath  String // private copy in Supabase Storage (bucket "decks")
  fileName     String
  fileSize     Int
  status       DeckAnalysisStatus @default(PENDING)
  model        String?
  extracted    Json? // suggested Venture fields
  screen       Json? // structured eligibility screen
  error        String?
  inputTokens  Int?
  outputTokens Int?
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  reviews    EligibilityReview[]
  aiContext  Json? // the criteria version and lessons this screen was given (null: built-in defaults)
  intakeOnly Boolean             @default(false) // board upload: only name/founder/stage read, no eligibility screen

  @@index([ventureId, createdAt])
}

enum EligibilityDecision {
  PROCEED
  DECLINE
  NEED_MORE_INFO
}

// The human decision on an eligibility screen. Append-only: a later decision is a
// new row. PROCEED and DECLINE also move the deal (via moveVentureStage).
model EligibilityReview {
  id          String              @id @default(cuid())
  ventureId   String
  venture     Venture             @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  analysisId  String?
  analysis    DeckAnalysis?       @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  decision    EligibilityDecision
  passReason  PassReason?
  note        String?
  decidedById String
  decidedBy   User                @relation(fields: [decidedById], references: [id])
  decidedAt   DateTime            @default(now())

  @@index([ventureId, decidedAt])
}

// ── Documents (DXV OS is the deal-lifecycle document store) ─────────────────

enum DocumentCategory {
  DECK
  MEMO
  DUE_DILIGENCE
  LEGAL
  FINANCIALS
  OTHER
}

// A file stored in DXV OS (Supabase Storage). Never deleted: DXV keeps all deal
// material, including declined deals, to learn from its dealflow. Mistaken uploads
// are archived (hidden), not deleted.
model Document {
  id               String           @id @default(cuid())
  ventureId        String
  venture          Venture          @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  category         DocumentCategory
  bucket           String // Supabase Storage bucket ("documents", or "decks" for AI-screened decks)
  storagePath      String
  fileName         String
  mimeType         String
  sizeBytes        Int
  angelVisibleFrom AngelDocPhase? // shared deals: when members see this file (null = never; the deck shows automatically)
  ddItemId         String? // attached to a DD checklist item
  ddItem           DDItem?          @relation(fields: [ddItemId], references: [id], onDelete: SetNull)
  note             String?
  uploadedById     String
  uploadedBy       User             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt        DateTime         @default(now())
  uploadedAt       DateTime? // set once the browser confirms the upload finished (null = incomplete)
  archivedAt       DateTime?
  archivedById     String?
  archivedBy       User?            @relation("DocumentArchivedBy", fields: [archivedById], references: [id])

  memoVersion MemoVersion?
  ddReportJob DDReportJob?

  @@unique([bucket, storagePath])
  @@index([ventureId, category])
}

// ── DD document generator ───────────────────────────────────────────────────

// One "Create DD document" run: AI drafts a DD plan, the worker builds a DXV-branded
// Word file and stores it as a Document (category Due diligence).
model DDReportJob {
  id           String             @id @default(cuid())
  ventureId    String
  venture      Venture            @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  status       DeckAnalysisStatus @default(PENDING)
  model        String?
  context      Json // deal details, memo, eligibility screen, DD items, deck location
  output       Json? // the AI's DD plan
  documentId   String?            @unique
  document     Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  error        String?
  inputTokens  Int?
  outputTokens Int?
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([ventureId, createdAt])
}

// ── Playbook: DXV's criteria and lessons (feeds the AI; later, the DXV Brain) ──

enum PlaybookKind {
  ELIGIBILITY // the eligibility screen criteria
  ASSESSMENT // the investment assessment scoring criteria and taxonomy
}

// Append-only: every save of the criteria is a new numbered version (who, when, why).
// The AI uses the latest version; each AI run records the version it was given.
// Version 0 is the built-in default (DXV's original documents), not stored.
model PlaybookVersion {
  id          String       @id @default(cuid())
  kind        PlaybookKind
  version     Int
  content     Json // shape: src/lib/playbook/schema.ts
  note        String? // what changed and why
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@unique([kind, version])
}

enum LessonScope {
  GENERAL
  ELIGIBILITY
  ASSESSMENT
  DUE_DILIGENCE
  PORTFOLIO
}

enum LessonStatus {
  SUGGESTED // proposed by the AI, waiting for a person
  APPROVED // used by the AI steps
  ARCHIVED // kept, not used (nothing is deleted)
}

enum LessonSource {
  HUMAN
  AI
}

// What DXV has learned. Approved lessons are given to the AI eligibility screen and
// investment assessment; they are the DXV Brain's knowledge base later.
model Lesson {
  id           String       @id @default(cuid())
  title        String
  body         String
  scope        LessonScope  @default(GENERAL)
  status       LessonStatus @default(APPROVED)
  source       LessonSource @default(HUMAN)
  origin       String? // e.g. "Suggested when Papcup was declined at Pitch Outcome"
  ventureId    String? // the deal it came from, if any
  venture      Venture?     @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  jobId        String? // the AI job that suggested it
  job          LessonJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdById  String? // null when suggested by the AI
  createdBy    User?        @relation("LessonCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?        @relation("LessonApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  updatedById  String?
  updatedBy    User?        @relation("LessonUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, scope])
}

enum LessonTrigger {
  DECLINED // a deal was declined
  MEMO_REVIEWED // a DXV Review Issue was released after the team changed the AI's scores
  ELIGIBILITY_DECIDED // the team's eligibility decision differed from the AI's recommendation
}

// Background job: the AI reviews a moment in a deal and suggests lessons (status SUGGESTED).
model LessonJob {
  id           String             @id @default(cuid())
  ventureId    String
  venture      Venture            @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  trigger      LessonTrigger
  status       DeckAnalysisStatus @default(PENDING)
  model        String?
  context      Json
  error        String?
  inputTokens  Int?
  outputTokens Int?
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  lessons      Lesson[]

  @@index([ventureId, createdAt])
}

// ── DXV Brain: the team's AI assistant ──────────────────────────────────────

// A chat with the DXV Brain. Private to the person who started it. Archived, not deleted.
model BrainConversation {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  title      String
  context    Json // snapshot for the whole chat: Playbook versions and approved lessons the Brain was given
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  archivedAt DateTime?
  messages   BrainMessage[]

  @@index([userId, updatedAt])
}

enum BrainRole {
  USER
  ASSISTANT
}

// One turn. `content` is exactly what was sent to (user) or returned by (assistant)
// Claude, replayed unchanged on the next question; `text` is what the person sees.
// Assistant replies are written by a background worker (status, live text, activity).
model BrainMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   BrainConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           BrainRole
  text           String             @default("")
  content        Json?
  pagePath       String? // user turns: the page it was asked from
  ventureId      String? // user turns: the deal on that page, if any
  status         DeckAnalysisStatus @default(COMPLETE)
  activity       String? // assistant, while working: e.g. "Searching the web"
  sources        Json? // assistant: web pages it cited, [{ title, url }]
  error          String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime           @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([conversationId, createdAt])
}

// ── Angels (spec §8) ────────────────────────────────────────────────────────

enum AngelStatus {
  PROSPECT // interested / being recruited, not yet a member
  MEMBER
  LAPSED // was a member, no longer active
}

// FCA financial promotion exemptions (COBS 4.12) an angel can rely on.
enum CertificationType {
  HIGH_NET_WORTH // certified high net worth individual statement (12 months)
  SELF_CERTIFIED_SOPHISTICATED // self-certified sophisticated investor statement (12 months)
  CERTIFIED_SOPHISTICATED // certificate from an FCA-authorised firm (36 months)
}

// A syndicate member or prospect. Certification is kept as an append-only history
// (AngelCertification); the latest one decides whether they're current.
model Angel {
  id             String      @id @default(cuid())
  name           String
  email          String?     @unique
  phone          String?
  linkedinUrl    String?
  location       String?
  bio            String?
  status         AngelStatus @default(PROSPECT)
  sectors        String[] // sectors of interest
  tags           String[] // self-declared only (e.g. "Woman angel"); never guessed
  whatsappGroups String[] // DXV WhatsApp groups they're in (recorded, not integrated)
  source         String? // how they came to DXV (event, referral, website...)
  membershipTier String? // reserved for the membership fee decision (spec §8); unused
  joinedAt       DateTime? // became a member
  archivedAt     DateTime? // hidden (duplicates, mistakes); never deleted
  ticketRange    String? // typical cheque size, as they told us (onboarding)
  experience     String? // angel investing experience, as they told us (onboarding)

  // Portal onboarding (each step stamped when done)
  termsAcceptedAt      DateTime?
  termsVersionId       String? // the ComplianceText (MEMBER_TERMS) they accepted
  profileConfirmedAt   DateTime?
  restrictedDeclaredAt DateTime? // said no FCA exemption applies: portal without deal content
  onboardedAt          DateTime? // finished onboarding (saw the welcome)
  emailOptOutAt        DateTime? // unsubscribed from bulk member emails (invites and resets still go)
  erasedAt             DateTime? // personal details erased ("Delete angel" on a record with history)
  createdById          String
  createdBy            User      @relation("AngelCreatedBy", fields: [createdById], references: [id])
  updatedById          String?
  updatedBy            User?     @relation("AngelUpdatedBy", fields: [updatedById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  certifications    AngelCertification[]
  notes             AngelNote[]
  aliases           AngelAlias[]
  preSelectionVotes PreSelectionVote[]
  investmentVotes   InvestmentVote[]
  finalInvestments  FinalInvestment[]
  user              User?                  @relation("AngelUser")
  invites           AngelInvite[]
  events            AngelEvent[]
  portfolio         PortfolioHolding[]
  memberEmails      MemberEmailRecipient[]
  portalViews       PortalView[]

  @@index([status])
}

// Append-only: each signed investor statement, with the file if there is one.
model AngelCertification {
  id               String            @id @default(cuid())
  angelId          String
  angel            Angel             @relation(fields: [angelId], references: [id], onDelete: Cascade)
  type             CertificationType
  signedOn         DateTime
  expiresOn        DateTime
  note             String?
  bucket           String? // the signed statement, in Supabase Storage ("documents")
  storagePath      String?
  fileName         String?
  mimeType         String?
  sizeBytes        Int?
  recordedById     String
  recordedBy       User              @relation(fields: [recordedById], references: [id])
  recordedAt       DateTime          @default(now())
  // Signed by the angel in the portal: the exact wording version, what they ticked, their typed name.
  signedByAngel    Boolean           @default(false)
  complianceTextId String?
  complianceText   ComplianceText?   @relation(fields: [complianceTextId], references: [id])
  criteria         String[]
  signatureName    String?
  ipAddress        String?

  @@index([angelId, signedOn])
}

// Append-only notes on an angel.
model AngelNote {
  id        String   @id @default(cuid())
  angelId   String
  angel     Angel    @relation(fields: [angelId], references: [id], onDelete: Cascade)
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([angelId, createdAt])
}

// A name as typed on votes and investments ("Kevin W"), confirmed as this angel. Links
// older free-text entries without editing them (votes are append-only).
model AngelAlias {
  id            String   @id @default(cuid())
  normalized    String   @unique // normaliseAngelName()
  angelId       String
  angel         Angel    @relation(fields: [angelId], references: [id], onDelete: Cascade)
  confirmedById String
  confirmedBy   User     @relation(fields: [confirmedById], references: [id])
  createdAt     DateTime @default(now())
}

// ── Angel portal ────────────────────────────────────────────────────────────

enum InviteKind {
  INVITE // first sign-up: create the angel's login
  RESET // set a new password (no email service yet, so admins hand these out)
}

// A one-time link to /join/<token>. Only a SHA-256 hash of the token is stored.
model AngelInvite {
  id          String     @id @default(cuid())
  angelId     String
  angel       Angel      @relation(fields: [angelId], references: [id], onDelete: Cascade)
  kind        InviteKind @default(INVITE)
  tokenHash   String     @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([angelId, createdAt])
}

enum ComplianceTextKind {
  HNW_STATEMENT // certified high net worth individual statement (FPO art. 48)
  SOPHISTICATED_STATEMENT // self-certified sophisticated investor statement (FPO art. 50A)
  MEMBER_TERMS // DXV member terms and privacy notice, accepted at sign-up
}

enum ComplianceTextStatus {
  DRAFT
  APPROVED // the one in use (one per kind)
  RETIRED // replaced by a newer approved version; kept, as signatures refer to it
}

// Versioned legal wording shown to angels. The body never changes once saved: an edit
// is a new version, and a version must be approved by an admin before angels see it.
model ComplianceText {
  id           String               @id @default(cuid())
  kind         ComplianceTextKind
  version      Int
  title        String
  body         String
  criteria     String[] // statements: the qualifying criteria the angel ticks (at least one)
  status       ComplianceTextStatus @default(DRAFT)
  note         String? // what changed and why
  createdById  String
  createdBy    User                 @relation("ComplianceTextCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime             @default(now())
  approvedById String?
  approvedBy   User?                @relation("ComplianceTextApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  certifications AngelCertification[]

  @@unique([kind, version])
}

// Append-only log of an angel's portal journey (invited, joined, signed, access revoked...).
model AngelEvent {
  id        String   @id @default(cuid())
  angelId   String
  angel     Angel    @relation(fields: [angelId], references: [id], onDelete: Cascade)
  kind      String
  detail    String?
  actorId   String? // who did it (an admin, or the angel's own login)
  createdAt DateTime @default(now())

  @@index([angelId, createdAt])
}

// ── Deal room ───────────────────────────────────────────────────────────────

// From which deal-room phase members see a document (the pitch deck needs no setting).
enum AngelDocPhase {
  POST_PITCH // from the post-pitch vote (Pitch Outcome): with the deck and memo
  COMMITMENTS // from Investment Commitments: the rest of the applicable documents
  DUE_DILIGENCE // from Due Diligence: only members who committed to invest in this deal
}

// Append-only: sharing and unsharing a deal with angels, and document visibility changes.
model DealShareLog {
  id        String   @id @default(cuid())
  ventureId String
  venture   Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  action    String // "shared", "unshared", "document", "summary"
  detail    String?
  byId      String
  by        User     @relation(fields: [byId], references: [id])
  createdAt DateTime @default(now())

  @@index([ventureId, createdAt])
}

// ── Team logins ─────────────────────────────────────────────────────────────

// One-time links for DXV team logins (partners): an invite (new login) or a password
// reset. Like angels' links: only the token's SHA-256 hash is stored, 14 days, used once.
model TeamInvite {
  id          String     @id @default(cuid())
  kind        InviteKind @default(INVITE)
  email       String
  name        String
  userId      String? // RESET: whose password; INVITE: the login it created (once used)
  user        User?      @relation("TeamInviteUser", fields: [userId], references: [id])
  tokenHash   String     @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User       @relation("TeamInviteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([email, createdAt])
}

// Append-only: who gave, used, reset, revoked or restored team access.
model TeamEvent {
  id        String   @id @default(cuid())
  subjectId String? // the team member (null for an invite not yet used)
  subject   User?    @relation("TeamEventSubject", fields: [subjectId], references: [id])
  email     String
  kind      String // "invited", "joined", "reset-link", "password-reset", "access-revoked", "access-restored"
  detail    String?
  actorId   String
  actor     User     @relation("TeamEventActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Members' round board ────────────────────────────────────────────────────

// Append-only: which DXV round members see on their read-only deals board (set on the
// Dashboard). The latest row counts; round null = no board. Card details still open only
// from Member Pitch Selection, for shared deals.
model MemberRound {
  id        String   @id @default(cuid())
  round     Int?
  byId      String
  by        User     @relation(fields: [byId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── My Portfolio (angels) ───────────────────────────────────────────────────

enum HoldingStatus {
  ACTIVE // "alive"
  EXITED // sold / acquired: see proceeds
  WRITTEN_OFF // failed: worth nothing
}

enum InvestmentInstrument {
  EQUITY // ordinary shares
  ASA // advance subscription agreement
  CLN // convertible loan note
  SAFE
  OTHER
}

enum TaxReliefScheme {
  SEIS
  EIS
  NONE
}

// An angel's own record of an investment, private to them (the team app never shows
// it). Either an investment made outside DXV (finalInvestmentId null: every field is
// theirs), or their details on a DXV syndicate investment (finalInvestmentId set: the
// company, amount and date come from DXV; this adds shares, value, paperwork, notes).
// Money in minor units (pence/cents). Removing one only sets archivedAt.
model PortfolioHolding {
  id                String           @id @default(cuid())
  angelId           String
  angel             Angel            @relation(fields: [angelId], references: [id], onDelete: Cascade)
  finalInvestmentId String?          @unique
  finalInvestment   FinalInvestment? @relation(fields: [finalInvestmentId], references: [id], onDelete: Cascade)

  // Outside DXV only (DXV investments take these from the deal and the ticket)
  companyName String?
  description String?
  sector      String?
  investedVia String? // "Direct", a syndicate or platform
  round       String? // "Pre-Seed", "Seed", ...
  investedOn  DateTime?
  currency    String    @default("GBP") // GBP, EUR, USD
  amountMinor Int?

  instrument               InvestmentInstrument?
  valuationAtInvestment    Int? // whole currency units
  sharePrice               Float?
  shares                   Int?
  currentValueMinor        Int?
  currentValueOn           DateTime?
  status                   HoldingStatus         @default(ACTIVE)
  proceedsMinor            Int? // exited: what they received
  taxScheme                TaxReliefScheme?
  taxCertificateReceived   Boolean               @default(false) // SEIS3 / EIS3
  shareCertificateReceived Boolean               @default(false)
  keyDate                  DateTime? // e.g. an ASA longstop, a follow-on, an exit window
  keyDateNote              String?
  source                   String? // how they heard about it
  rationale                String?
  notes                    String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([angelId, archivedAt])
}

// DXV's syndicate portfolio (the team's Portfolio page). Either the team's details on a
// deal DXV invested in (ventureId set: the company, amounts and angels come from the
// deal's Final Investment tickets), or a syndicate investment not tracked as a deal in
// DXV OS, e.g. an earlier round (ventureId null: every field is the team's).
// Money in minor units (pence/cents). Removing one only sets archivedAt.
model SyndicateHolding {
  id        String   @id @default(cuid())
  ventureId String?  @unique
  venture   Venture? @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  // Added by hand only (tracked deals take these from the deal)
  companyName  String?
  sector       String?
  round        Int? // DXV round
  companyStage String? // "Pre-Seed", "Seed", ...
  investedOn   DateTime?
  currency     String    @default("GBP")
  amountMinor  Int? // the syndicate's total
  angelsCount  Int?

  description           String?
  instrument            InvestmentInstrument?
  valuationAtInvestment Int? // whole currency units
  sharePrice            Float?
  currentValueMinor     Int?
  currentValueOn        DateTime?
  status                HoldingStatus         @default(ACTIVE)
  proceedsMinor         Int?
  taxScheme             TaxReliefScheme?
  diversityThemes       String[] // founder diversity: hand-added investments only (tracked deals use Venture.founderDiversity)
  notes                 String?

  createdById String
  createdBy   User      @relation("SyndicateHoldingCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("SyndicateHoldingUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  @@index([archivedAt])
}

// ── Self-service sign-in links ─────────────────────────────────────────────
// "Forgot password?" on the sign-in page emails a one-time link: a password reset, or a
// magic link that signs the person straight in. Any login (team or member) can ask; only
// the token's SHA-256 hash is stored; links are short-lived and used once. Rows are kept.
enum LoginLinkKind {
  RESET
  MAGIC
}

model LoginLink {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  kind        LoginLinkKind
  tokenHash   String        @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime? // a newer link of the same kind was sent
  requestedIp String?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
}

// ── Google / Microsoft sign-in ─────────────────────────────────────────────
// A Google or Microsoft account connected to a DXV login. Matched by the provider's stable
// id for the person (OIDC "sub"), never by email alone. Disconnecting sets removedAt (kept).
enum OAuthProvider {
  GOOGLE
  MICROSOFT
}

model LoginIdentity {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  provider      OAuthProvider
  subject       String // the provider's id for this person
  email         String? // the account's email when last used
  emailVerified Boolean       @default(false) // the provider vouches for the email
  emailChoiceAt DateTime? // they chose to switch to this email, or keep their DXV one
  createdAt     DateTime      @default(now())
  lastUsedAt    DateTime?
  removedAt     DateTime?

  @@unique([provider, subject])
  @@index([userId])
}

// ── Emails to angels ───────────────────────────────────────────────────────
// Team-edited templates (the welcome email, bulk-email starting points) and a record of
// every bulk email: what was sent, to whom, and how each send went. Bodies use
// {{first_name}} / {{platform_link}} placeholders and [text](url) links (src/lib/member-email.ts).
model EmailTemplate {
  id          String    @id @default(cuid())
  key         String?   @unique // "welcome": the email new angels get with their invite
  name        String
  subject     String
  body        String
  createdById String?
  createdBy   User?     @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
}

/**
 * A bulk email as sent (never edited afterwards).
 */
model MemberEmail {
  id          String                 @id @default(cuid())
  subject     String
  body        String
  audience    String // which group it was for (MEMBER_EMAIL_AUDIENCES)
  createdById String
  createdBy   User                   @relation(fields: [createdById], references: [id])
  createdAt   DateTime               @default(now())
  recipients  MemberEmailRecipient[]
}

enum MemberEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model MemberEmailRecipient {
  id            String            @id @default(cuid())
  memberEmailId String
  memberEmail   MemberEmail       @relation(fields: [memberEmailId], references: [id])
  angelId       String
  angel         Angel             @relation(fields: [angelId], references: [id])
  email         String // where it went
  status        MemberEmailStatus @default(PENDING)
  error         String?
  invited       Boolean           @default(false) // their email carried a new sign-up link
  sentAt        DateTime?

  @@unique([memberEmailId, angelId])
  @@index([memberEmailId, status])
}

// ── Member engagement (Insights page) ─────────────────────────────────────
// One row each time a member opens part of the portal: which part, which deal (for deal
// rooms and documents), when. No IP or device details. My Portfolio and My profile are
// recorded only as OTHER (active that day), never what was looked at. Partners using the
// portal are flagged (team) so Insights can leave them out. Team-only reading.
enum PortalViewKind {
  HOME
  BOARD
  DEAL
  DOCUMENT
  OTHER
}

model PortalView {
  id        String         @id @default(cuid())
  angelId   String
  angel     Angel          @relation(fields: [angelId], references: [id], onDelete: Cascade)
  kind      PortalViewKind
  ventureId String?
  team      Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([createdAt])
  @@index([angelId, createdAt])
  @@index([ventureId])
}

// ── Founder submissions (Blue, 2026-10-06) ─────────────────────────────────
// A founder's application from the public /apply page, exactly as they gave it. The deal
// itself is an ordinary Venture (created by the "DXV website" system user); this keeps
// what the founder said, their consents, and how the submission was handled.
enum SubmissionStatus {
  UPLOADING // form received, waiting for the deck upload to finish
  COMPLETE // deck stored, deal created or updated
  ABANDONED // the upload never finished
}

model FounderSubmission {
  id                  String           @id @default(cuid())
  status              SubmissionStatus @default(UPLOADING)
  completionTokenHash String // the browser's one-time proof it started this submission
  companyName         String
  founderNames        String
  email               String
  website             String?
  linkedinUrl         String?
  sector              String?
  companyStage        String?
  raiseAmountGbp      Int?
  pitch               String // their one-line description
  heardFrom           String?
  diversityThemes     String[] // only with diversity consent; as the founder stated
  privacyConsentAt    DateTime
  diversityConsentAt  DateTime?
  ipHash              String? // SHA-256 of the IP with SESSION_SECRET: rate limiting only
  analysisId          String?          @unique // the deck's AI reading
  ventureId           String?
  venture             Venture?         @relation("SubmissionVenture", fields: [ventureId], references: [id])
  resubmission        Boolean          @default(false) // the company was already on the board: deck added to it
  previousVentureId   String? // the company was declined before: a new deal, linked back
  digestedAt          DateTime? // included in the partners' daily digest
  createdAt           DateTime         @default(now())
  completedAt         DateTime?

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
}

/**
 * Every email DXV OS sends a founder (acknowledgements, decision updates). Never edited.
 */
enum FounderEmailKind {
  ACKNOWLEDGEMENT
  DECISION
}

model FounderEmail {
  id        String           @id @default(cuid())
  ventureId String
  venture   Venture          @relation(fields: [ventureId], references: [id])
  commId    String? // the FounderComm it answered (decision updates)
  kind      FounderEmailKind
  to        String
  subject   String
  body      String
  sentById  String? // null: sent automatically (acknowledgements)
  sentBy    User?            @relation(fields: [sentById], references: [id])
  error     String? // set when it didn't send
  createdAt DateTime         @default(now())

  @@index([ventureId, createdAt])
}

/// Password sign-in attempts, for slowing down password guessing (loginThrottle() in pipeline.ts).
/// Kept 30 days. IP stored only as a keyed hash.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String?
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}
